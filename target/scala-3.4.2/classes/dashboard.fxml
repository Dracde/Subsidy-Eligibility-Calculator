<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.DashboardController" spacing="12" style="-fx-background-color: #f4f6f8;">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <children>
        <Label text="Subsidy Programme Dashboard" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1b3a57;"/>
        <Label fx:id="summaryLabel" text="" style="-fx-font-size: 13px; -fx-text-fill: #4a4a4a;"/>
        <Label text="Remaining quota per subsidy:" style="-fx-font-size: 13px; -fx-text-fill: #4a4a4a;"/>
        <VBox fx:id="chartSection" spacing="10"/>
    </children>
</VBox>
