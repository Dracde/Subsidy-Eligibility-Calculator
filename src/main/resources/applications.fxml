<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.ApplicationsController" spacing="12" style="-fx-background-color: #f4f6f8;">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <children>
        <Label text="Subsidy Applications" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1b3a57;"/>
        <Label text="Submit a new application, then approve or reject pending ones below."
               style="-fx-font-size: 13px; -fx-text-fill: #4a4a4a;"/>

        <HBox spacing="8">
            <children>
                <Label text="Household:"/>
                <ComboBox fx:id="householdComboBox" prefWidth="200"/>
                <Label text="Eligible subsidy:"/>
                <ComboBox fx:id="subsidyComboBox" prefWidth="220"/>
                <Label text="Review deadline:"/>
                <DatePicker fx:id="reviewDeadlinePicker"/>
                <Button fx:id="applyButton" text="Submit Application" defaultButton="true" onAction="#handleApply"/>
            </children>
        </HBox>

        <Label fx:id="statusLabel" text="" style="-fx-text-fill: #2f6fb0;"/>

        <TableView fx:id="applicationTableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="applicationIdColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="applicationHouseholdColumn" text="Household" prefWidth="180"/>
                <TableColumn fx:id="applicationSubsidyColumn" text="Subsidy" prefWidth="200"/>
                <TableColumn fx:id="appliedDateColumn" text="Applied" prefWidth="100"/>
                <TableColumn fx:id="reviewDeadlineColumn" text="Review Deadline" prefWidth="120"/>
                <TableColumn fx:id="statusColumn" text="Status / Overdue?" prefWidth="130"/>
                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="160"/>
            </columns>
        </TableView>
    </children>
</VBox>
