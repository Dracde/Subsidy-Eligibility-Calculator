<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.SubsidiesController" spacing="10" style="-fx-background-color: #f4f6f8;">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <children>
        <Label text="Subsidy Programmes" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1b3a57;"/>
        <Label text="Register, update, remove, and search subsidy programmes."
               style="-fx-font-size: 13px; -fx-text-fill: #4a4a4a;"/>

        <GridPane hgap="8" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="150"/>
                <ColumnConstraints minWidth="260"/>
            </columnConstraints>
            <children>
                <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="nameField" promptText="e.g. Food Assistance Subsidy"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="descriptionField" promptText="e.g. Monthly grocery vouchers"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Income threshold (RM):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="incomeThresholdField" promptText="e.g. 2000.00"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Remaining quota:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="quotaField" promptText="e.g. 50" onAction="#handleAdd"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </children>
        </GridPane>

        <HBox spacing="8">
            <children>
                <Button fx:id="addButton" text="Add Subsidy" defaultButton="true" onAction="#handleAdd"/>
                <Button fx:id="updateButton" text="Update Selected" onAction="#handleUpdate"/>
                <Button fx:id="removeButton" text="Remove Selected" onAction="#handleRemove"/>
                <Button fx:id="clearButton" text="Clear Form" onAction="#handleClear"/>
            </children>
        </HBox>

        <Label fx:id="statusLabel" text="" style="-fx-text-fill: #2f6fb0;"/>

        <HBox spacing="8">
            <children>
                <Label text="Search:"/>
                <TextField fx:id="searchField" promptText="Search by name or description..." HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>

        <TableView fx:id="subsidyTableView" prefHeight="220" maxHeight="220">
            <columns>
                <TableColumn fx:id="subsidyIdColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="subsidyNameColumn" text="Name" prefWidth="180"/>
                <TableColumn fx:id="subsidyDescriptionColumn" text="Description" prefWidth="220"/>
                <TableColumn fx:id="subsidyThresholdColumn" text="Income Threshold (RM)" prefWidth="150"/>
                <TableColumn fx:id="subsidyQuotaColumn" text="Remaining Quota" prefWidth="120"/>
            </columns>
        </TableView>

        <Label text="Households currently eligible for the selected subsidy:"
               style="-fx-font-size: 13px; -fx-text-fill: #4a4a4a;" minHeight="-Infinity"/>

        <TableView fx:id="eligibleHouseholdTableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="eligibleNameColumn" text="Full Name" prefWidth="220"/>
                <TableColumn fx:id="eligibleIncomeColumn" text="Monthly Income (RM)" prefWidth="180"/>
            </columns>
        </TableView>
    </children>
</VBox>
